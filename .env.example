# PostgreSQL database connection URL (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doubtly?schema=public"

# Secret key for JWT signing (jose HS256). Minimum 32 characters.
JWT_SECRET="super-secret-jwt-key-doubtly-at-least-32-chars-long"

# Default admin credentials for seeding / recovery
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2a$12$e8K7bW3.c0M912O4Fv1OwePzIuS.b4MzgE2aK36lJ1fDkS50VjEhy"

# Cloudinary credentials for PDF and image uploads
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyza@demo"

# Public site URL (for canonical tags, SEO, OpenGraph cards)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

